# Set this to the backend API prefix to use real student accounts and data.
# Leave unset for the clearly labelled interface preview.
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
# Local demo only: sign in as student1 on first visit and switch real demo accounts.
VITE_DEMO_ROLE_SWITCH=false
# Set full only for an explicitly requested animation demo; otherwise follow accessibility settings.
VITE_TICKET_MOTION=system
